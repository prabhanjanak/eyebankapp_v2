# ==============================================================================
# SANKARA EYE BANK - PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and replace all placeholder values with your real credentials.
# Command: cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE SERVER & RUNTIME
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=8080

# Public-facing Base URL of the web portal (Used in email certificates & SMS/WhatsApp links)
# Example: https://eyebank.sankara.org
APP_BASE_URL=http://localhost:8080

# Allowed CORS Origins (comma-separated for multiple domains, or set to your frontend domain)
# Example: https://eyebank.sankara.org,https://admin.sankara.org
CORS_ORIGIN=http://localhost:8080,http://localhost:8081

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (PostgreSQL 14+)
# ------------------------------------------------------------------------------
# For Docker Compose deployments (auto-used if running docker compose up):
DB_USER=sankara_user
DB_PASSWORD=YourStrongDatabasePassword123!#
DB_NAME=sankara_eyebank

# Standard PostgreSQL connection URI (for PM2 / native deployments):
# postgresql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:<DB_PORT>/<DB_NAME>
DATABASE_URL=postgresql://sankara_user:YourStrongDatabasePassword123!#@127.0.0.1:5432/sankara_eyebank

# Set to true if connecting to a cloud-managed database requiring SSL (e.g., AWS RDS, Supabase, Neon, DigitalOcean)
DATABASE_SSL=false

# Connection Pool size (Default: 20 connections)
DATABASE_POOL_MAX=20

# ------------------------------------------------------------------------------
# 3. SECURITY & AUTHENTICATION SECRETS
# ------------------------------------------------------------------------------
# Generate strong, random 64-character hex strings:
# Command to generate: openssl rand -hex 32
JWT_SECRET=replace_with_a_secure_random_64_character_secret_key_here
SESSION_SECRET=replace_with_another_secure_random_64_character_secret_key_here

# ------------------------------------------------------------------------------
# 4. EMAIL NOTIFICATIONS (SMTP) - Optional (Can also be configured via Web UI Settings)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=alerts@sankaraeye.com
SMTP_PASS=your_email_app_password
SMTP_FROM=Sankara Eye Bank Alerts <alerts@sankaraeye.com>

# ------------------------------------------------------------------------------
# 5. WHATSAPP & SMS ALERTS - Optional (Can also be configured via Web UI Settings)
# ------------------------------------------------------------------------------
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_NAME=living_eye_pledge_certificate
SMS_API_KEY=

# ------------------------------------------------------------------------------
# 6. LOGGING & DATA STORAGE PATHS
# ------------------------------------------------------------------------------
LOG_LEVEL=info
SETTINGS_FILE_PATH=./data/settings.json
